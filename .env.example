# Copy to .env (docker compose reads it automatically).
ADMIN_PASSWORD=change-me
# Where the pages are served from, comma-separated. No trailing slash.
ALLOWED_ORIGINS=https://your-site.pages.dev,http://localhost:5500
# Public hostname and port Caddy serves the API on: the VPS IP with dashes, via sslip.io.
API_ADDRESS=api.203-0-113-10.sslip.io:8443
